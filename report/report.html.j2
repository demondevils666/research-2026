<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Город больше своих границ — методологический отчет</title>
<style>
  :root { --ink: #0b0b0b; --ink2: #52514e; --muted: #8a8984; --grid: #e6e5e0; --accent: #2a78d6; --surface: #fcfcfb; }
  @page { size: A4; }
  html { background: var(--surface); }
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; font-size: 10.2pt; line-height: 1.45;
         color: var(--ink); max-width: 175mm; margin: 0 auto; padding: 0 2mm; background: var(--surface); }
  h1 { font-size: 21pt; line-height: 1.15; margin: 0 0 4pt; letter-spacing: -0.2pt; }
  h1 + p { color: var(--ink2); margin-top: 0; }
  h2 { font-size: 14pt; margin: 20pt 0 6pt; padding-top: 6pt; border-top: 1px solid var(--grid); break-after: avoid; }
  h3 { font-size: 11.2pt; margin: 14pt 0 4pt; break-after: avoid; }
  p, li { orphans: 3; widows: 3; overflow-wrap: break-word; }
  ul, ol { padding-left: 16pt; margin: 4pt 0 8pt; }
  li { margin: 2pt 0; }
  table { border-collapse: collapse; width: 100%; margin: 6pt 0 10pt; font-size: 8.8pt; line-height: 1.3; break-inside: avoid; }
  th { text-align: left; font-weight: 700; color: var(--ink2); border-bottom: 1.2px solid var(--ink2); padding: 3pt 5pt; vertical-align: bottom; }
  td { border-bottom: 1px solid var(--grid); padding: 3pt 5pt; vertical-align: top; }
  img { max-width: 100%; display: block; margin: 8pt auto 2pt; break-inside: avoid; }
  img + em, p > em:only-child { display: block; color: var(--muted); font-size: 8.5pt; margin-bottom: 8pt; }
  code { font-family: "DejaVu Sans Mono", monospace; font-size: 8.6pt; background: #f0efec; padding: 0 2pt; border-radius: 2pt; }
  pre { background: #f0efec; padding: 6pt 8pt; border-radius: 3pt; font-size: 8.4pt; white-space: pre-wrap; overflow-wrap: anywhere; break-inside: avoid; }
  pre code { background: none; padding: 0; }
  blockquote { margin: 8pt 0; padding: 6pt 10pt; border-left: 3px solid var(--accent); background: #f4f7fc; color: var(--ink); }
  blockquote p { margin: 3pt 0; }
  strong { font-weight: 700; }
  a { color: var(--accent); text-decoration: none; }
  .toc ul { list-style: none; padding-left: 10pt; }
  @media print { h2 { break-before: auto; } a { color: var(--ink); } }
</style>
</head>
<body>
{{ body }}
</body>
</html>
